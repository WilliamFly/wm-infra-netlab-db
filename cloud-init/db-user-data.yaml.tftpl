#cloud-config
hostname: netlab-db
manage_etc_hosts: true

users:
  - name: netlab-admin
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}
    lock_passwd: true

ssh_pwauth: false
package_update: true

packages:
  - postgresql

# NOTE: assumes Ubuntu 24.04's default apt Postgres package is major
# version 16 (true as of this writing — Ubuntu noble ships PG16). If a
# future apt update changes the default major version, these paths will
# need updating to match.
runcmd:
  - [ bash, -c, "echo \"listen_addresses = '*'\" >> /etc/postgresql/16/main/postgresql.conf" ]
  - [ bash, -c, "echo \"host all all ${private_subnet} scram-sha-256\" >> /etc/postgresql/16/main/pg_hba.conf" ]
  - systemctl restart postgresql
  - [ bash, -c, "sudo -u postgres psql -c \"CREATE USER ${db_app_user} WITH PASSWORD '${db_app_password}';\"" ]
  - [ bash, -c, "sudo -u postgres psql -c \"CREATE DATABASE ${db_name} OWNER ${db_app_user};\"" ]

# Hardening (harden-baseline) deliberately not applied here yet — this VM
# exists first to prove private-net -> data-net connectivity with a real
# service. Hardening can be layered on via Ansible the same way the
# router got it, once this step is confirmed working.
